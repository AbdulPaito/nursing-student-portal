          <div class="relative">
            <div class="w-16 h-16 rounded-2xl bg-white/20 flex items-center justify-center pulse-ring animate-float p-1">
              <img src="../images/msu-logo.png" alt="Marinduque State University" class="w-14 h-14 object-contain" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\\'fa-solid fa-building-columns text-white text-2xl\\'></i>';">
