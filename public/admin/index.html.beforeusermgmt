      <!-- Navigation -->
      <nav class="p-4 space-y-2">
        <a href="#" data-section="dashboard" class="sidebar-link active flex items-center gap-3 px-4 py-3.5 rounded-xl text-white/80 hover:text-white hover:bg-white/10 transition-all duration-300 group">
