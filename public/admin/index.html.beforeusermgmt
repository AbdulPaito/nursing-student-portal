              <option value="Wednesday">Wednesday</option>
              <option value="Thursday">Thursday</option>
              <option value="Friday">Friday</option>
              <option value="Saturday">Saturday</option>
              <option value="Sunday">Sunday</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Subject Name <span class="text-rose-500">*</span></label>
            <select id="subjectNameSelect" required class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow">
              <option value="">Select a subject</option>
              <option value="Mathematics">Mathematics</option>
              <option value="Science">Science</option>
              <option value="English">English</option>
              <option value="History">History</option>
              <option value="Physical Education">Physical Education</option>
              <option value="Computer Science">Computer Science</option>
              <option value="Other">Other (Specify below)</option>
            </select>
          </div>

          <div id="subjectNameOtherWrap" class="hidden">
            <label class="block text-sm font-semibold text-gray-700 mb-2">Specify Subject Name <span class="text-rose-500">*</span></label>
            <input type="text" id="subjectNameOther" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow" placeholder="Enter custom subject name">
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Type</label>
            <select id="subjectType" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow">
              <option value="Theory">Theory</option>
              <option value="Laboratory">Laboratory</option>
              <option value="Lecture">Lecture</option>
              <option value="Practical">Practical</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Items Needed (one per line)</label>
            <textarea id="subjectItems" rows="3" placeholder="Item 1&#10;Item 2&#10;Item 3" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow resize-none"></textarea>
          </div>
        </div>
        
        <div class="flex justify-end gap-3 mt-8">
          <button type="button" class="px-6 py-3 text-gray-600 hover:text-gray-800 font-semibold transition-colors" onclick="closeModal('subjectModal')">Cancel</button>
          <button type="button" id="subjectSaveBtn" class="px-6 py-3.5 bg-gradient-to-r from-primary-600 to-secondary-600 hover:from-primary-700 hover:to-secondary-700 text-white font-semibold rounded-xl shadow-xl shadow-primary-500/30 transition-all hover:-translate-y-0.5">Save Subject</button>
        </div>
      </div>
    </div>
  </div>


  </div>

  <!-- Toast Container -->
  <div id="toastContainer" class="fixed top-6 right-6 z-[9999] space-y-3"></div>

  <!-- Teacher Modal -->
  <div id="teacherModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 animate-fade-in" style="display: none;">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeModal('teacherModal')"></div>
    <div class="glass rounded-3xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto relative animate-scale-in p-8">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-2xl font-bold text-gray-800" id="teacherModalTitle">Add Teacher</h3>
          <p class="text-gray-500 text-sm mt-1">Fill in the teacher information</p>
        </div>
        <button onclick="closeModal('teacherModal')" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors">
          <i class="fa-solid fa-xmark text-gray-600"></i>
        </button>
      </div>

      <form id="teacherForm" class="space-y-4">
        <input type="hidden" id="teacherId">
        
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Full Name *</label>
          <input type="text" id="teacherName" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="Enter teacher's full name">
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Position *</label>
          <input type="text" id="teacherPosition" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="e.g., Professor, Instructor, Dean">
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Department *</label>
          <input type="text" id="teacherDepartment" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="e.g., Nursing, Medical Technology">
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Contact Number</label>
          <input type="text" id="teacherContact" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="e.g., 09xx-xxx-xxxx">
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
          <input type="email" id="teacherEmail" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="teacher@example.com">
        </div>

        <div class="flex gap-3 pt-4">
          <button type="button" onclick="closeModal('teacherModal')" class="flex-1 px-6 py-3 bg-gray-100 text-gray-700 rounded-xl font-semibold hover:bg-gray-200 transition-all">
            Cancel
          </button>
          <button type="button" id="teacherSaveBtn" class="flex-1 px-6 py-3 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-xl font-semibold hover:from-emerald-600 hover:to-emerald-700 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-save"></i>
            Save Teacher
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Student Modal -->
  <div id="studentModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 animate-fade-in" style="display: none;">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeModal('studentModal')"></div>
    <div class="glass rounded-3xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto relative animate-scale-in p-8">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-2xl font-bold text-gray-800" id="studentModalTitle">Add Student</h3>
          <p class="text-gray-500 text-sm mt-1">Fill in the student information</p>
        </div>
        <button onclick="closeModal('studentModal')" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200 flex items-center justify-center transition-colors">
          <i class="fa-solid fa-xmark text-gray-600"></i>
        </button>
      </div>

      <form id="studentForm" class="space-y-4">
        <input type="hidden" id="studentId">
        
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Full Name *</label>
          <input type="text" id="studentName" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="Enter student's full name">
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Year Level *</label>
            <select id="studentYearLevel" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all">
              <option value="">Select Year Level</option>
              <option value="1st Year">1st Year</option>
              <option value="2nd Year">2nd Year</option>
              <option value="3rd Year">3rd Year</option>
              <option value="4th Year">4th Year</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Section</label>
            <input type="text" id="studentSection" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="e.g., A, B, C">
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Contact Number</label>
          <input type="text" id="studentContact" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="e.g., 09xx-xxx-xxxx">
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
          <input type="email" id="studentEmail" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary-500 focus:ring-2 focus:ring-primary-200 transition-all" placeholder="student@example.com">
        </div>

        <div class="flex gap-3 pt-4">
          <button type="button" onclick="closeModal('studentModal')" class="flex-1 px-6 py-3 bg-gray-100 text-gray-700 rounded-xl font-semibold hover:bg-gray-200 transition-all">
            Cancel
          </button>
          <button type="button" id="studentSaveBtn" class="flex-1 px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-xl font-semibold hover:from-blue-600 hover:to-blue-700 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-save"></i>
            Save Student
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- JavaScript -->
  <!-- Daily Subject Modal -->
  <div id="dailySubjectModal" class="fixed inset-0 z-50 hidden" style="display: none;">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-md transition-opacity" onclick="closeDailySubjectModal()"></div>
    <div class="fixed inset-0 flex items-center justify-center p-4 z-10 overflow-y-auto">
      <div class="glass rounded-3xl shadow-2xl w-full max-w-2xl p-8 animate-scale-in my-8">
        <button type="button" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-gray-100 text-gray-500 hover:text-gray-700 hover:bg-gray-200 flex items-center justify-center transition-all" onclick="closeDailySubjectModal()">
          <i class="fa-solid fa-xmark text-xl"></i>
        </button>
        
        <div class="flex items-center gap-3 mb-6">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-primary-500 to-secondary-500 flex items-center justify-center">
            <i class="fa-solid fa-calendar-plus text-white text-xl"></i>
          </div>
          <h3 class="text-2xl font-bold text-gray-800" id="dailySubjectModalTitle">Add Daily Subject</h3>
        </div>
        
        <input type="hidden" id="dailySubjectId">
        <input type="hidden" id="dailySubjectDay">
        
        <div class="space-y-5">
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Subject Code <span class="text-rose-500">*</span></label>
              <input type="text" id="dailySubjectCode" required class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow" placeholder="e.g., NS101">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Subject Name <span class="text-rose-500">*</span></label>
              <input type="text" id="dailySubjectName" required class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow" placeholder="e.g., Fundamentals of Nursing">
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Start Time <span class="text-rose-500">*</span></label>
              <input type="time" id="dailySubjectStartTime" required class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">End Time <span class="text-rose-500">*</span></label>
              <input type="time" id="dailySubjectEndTime" required class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow">
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Type <span class="text-rose-500">*</span></label>
              <select id="dailySubjectType" required class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow" onchange="toggleDailySubjectCustomType()">
                <option value="">Select type</option>
                <option value="Lecture">Lecture</option>
                <option value="Practical/Lab">Practical/Lab</option>
                <option value="Seminar">Seminar</option>
                <option value="Other">Other</option>
              </select>
              <input type="text" id="dailySubjectTypeCustom" placeholder="Enter custom type" class="hidden w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow mt-3">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Date (Optional)</label>
              <input type="date" id="dailySubjectDate" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow">
              <p class="text-xs text-gray-500 mt-1">For specific date</p>
            </div>
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Room/Location</label>
            <input type="text" id="dailySubjectRoom" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow" placeholder="e.g., Room 101">
          </div>
          
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Instructor</label>
            <input type="text" id="dailySubjectInstructor" class="w-full px-4 py-3.5 bg-gray-50 border-2 border-gray-200 rounded-xl text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:bg-white focus:outline-none transition-all input-glow" placeholder="e.g., Prof. Juan Dela Cruz">
          </div>
        </div>
        
        <div class="flex gap-3 mt-8">
          <button type="button" onclick="closeDailySubjectModal()" class="flex-1 px-6 py-3.5 bg-gray-100 text-gray-700 rounded-xl font-semibold hover:bg-gray-200 transition-all">
            Cancel
          </button>
          <button type="button" id="dailySubjectSaveBtn" onclick="saveDailySubject()" class="flex-1 px-6 py-3.5 bg-gradient-to-r from-primary-600 to-secondary-600 text-white rounded-xl font-semibold hover:shadow-lg transition-all">
            Save Subject
          </button>
        </div>
      </div>
    </div>
  </div>

  <script src="admin-tailwind.js"></script>
</body>
</html>
