# MongoDB Atlas Connection
# Get this from MongoDB Atlas dashboard - replace with your actual connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret for token signing
# Generate a strong random string (e.g., use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_this_to_a_random_string

# Admin Account Configuration
# These are used by the seed script to create the first admin user
ADMIN_EMAIL=admin@nursing.com
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_NAME=Admin User

# Server Configuration
PORT=3000

# CORS Configuration (for Netlify deployment)
# Comma-separated list of allowed origins (include your Netlify URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Optional: MongoDB Connection Retry Settings
MONGODB_CONNECT_MAX_ATTEMPTS=20
MONGODB_CONNECT_RETRY_DELAY_MS=5000

# Cloudinary Configuration (for music file uploads - Netlify/Render deployment)
# Sign up at https://cloudinary.com and get these from your dashboard
# IMPORTANT: You MUST configure these for music uploads to work!
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration (for Forgot Password PIN)
# Use Gmail: Enable "2-Step Verification" then generate "App Password"
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM_NAME=MSU Nursing Portal
